# Machine-specific settings. Copy to local.env (gitignored) and edit.
# Read by: systemd units (EnvironmentFile), llama-swap (${env.X}), local_llm.py.
# Absolute paths only (systemd does not expand ~).
PROJECT_DIR=/home/<user>/path/to/local-llm
LLAMA_SERVER=/home/<user>/src/llama.cpp/build/bin/llama-server
MODELS_DIR=/home/<user>/models
# reference only (docs / operator): how clients reach this box
LAN_HOST=<lan-ip>
TAILSCALE_HOST=<tailscale-hostname>
